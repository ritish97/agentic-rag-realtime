# Groq API Key (get your free key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (qwen/qwen3.8-27b recommended for optimal tool calling and speed)
# Supported models on your account: qwen/qwen3.8-27b, openai/gpt-oss-120b, openai/gpt-oss-20b
GROQ_MODEL=qwen/qwen3.8-27b

# Web Search - Tavily API (free tier: 1000 requests/month)
# Sign up at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# OpenWeatherMap API (free tier: 60 calls/min)
# Sign up at: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_openweathermap_key_here

# Knowledge base directory path
KNOWLEDGE_BASE_DIR=data/knowledge_base
